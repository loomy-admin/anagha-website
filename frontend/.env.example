# Anagha Express BFF (not the Octis ERP port)
BACKEND_URL=http://localhost:4001

# Optional public site URL (SSR catalog self-fetch)
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google Sign-In (browser)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Cloud Run — BACKEND_URL is baked into Next rewrites at docker build.
# Also set BACKEND_URL on the frontend Cloud Run service for SSR fetches.
# BACKEND_URL=https://anagha-backend-xxxxx.asia-south1.run.app
# NEXT_PUBLIC_BASE_URL=https://anagha-frontend-xxxxx.asia-south1.run.app
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
