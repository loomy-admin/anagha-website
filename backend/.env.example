# Anagha BFF
PORT=4001
CORS_ORIGIN=http://localhost:3000
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/anagha?sslmode=require"

# Customer session cookies (min 16 chars). Set COOKIE_SECURE=true on HTTPS.
SESSION_SECRET=change-me-to-at-least-16-chars
# COOKIE_SECURE=true

# ERP is import-only (Re-import ERP). Storefront uses Postgres + image storage.

# Google Cloud Storage for catalog + CMS photos. If unset, files go to local /uploads.
# Required on Cloud Run (ephemeral disk). Leave GCS_CLIENT_EMAIL / GCS_PRIVATE_KEY
# unset on Cloud Run — the runtime service account is used instead.
# GCS_BUCKET=anagha-website-assets
# GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/anagha-website-assets
# GCS_PROJECT_ID=your-gcp-project
# GCS_MAKE_PUBLIC=true

# Cloud SQL from Cloud Run (Unix socket). Replace PROJECT, INSTANCE, USER, PASSWORD:
# DATABASE_URL="postgresql://USER:PASSWORD@/anagha?host=/cloudsql/PROJECT:asia-south1:INSTANCE"

ERP_API_URL=https://gold-develop-backend-1006591540334.asia-south1.run.app/api
ERP_STORE_SLUG=test1
ERP_BRANCH_ID=344c1559-270c-46d9-b09d-19dfbd96b982
WEBSTORE_SECRET=anagha-dev-webstore-9f3c8e2a7b1d4e6f
