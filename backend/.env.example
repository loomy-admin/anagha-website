# Public URLs (redirects / thanks page / emails)
PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:4001

# Cloud Run:
# CORS_ORIGIN=https://YOUR-FRONTEND.run.app
# PUBLIC_BASE_URL=https://YOUR-FRONTEND.run.app
# PUBLIC_API_BASE_URL=https://YOUR-BACKEND.run.app
# COOKIE_SECURE=true

